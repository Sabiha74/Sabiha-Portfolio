# Email Service Configuration (Resend)
# 1. Sign up at https://resend.com and generate an API key
# 2. Add RESEND_API_KEY below and copy this file to .env.local
RESEND_API_KEY=re_your_api_key_here

# Recipient email address where contact form submissions will be delivered
CONTACT_EMAIL=sabihamashruha74@gmail.com

# Verified sender email address (Resend free test sender is onboarding@resend.dev)
# Once you verify your custom domain on Resend, you can change this to:
# SENDER_EMAIL="Sabiha Portfolio <contact@yourdomain.com>"
SENDER_EMAIL="Portfolio Contact <onboarding@resend.dev>"

